APP_NAME=SayNO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Produksi: https://sayno.lokashaka.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SayNO ---------------------------------------------------------------
# Rahasia hanya di .env (jangan di-commit, jangan di-log). Lihat CLAUDE.md.

# Nomor bot dalam format internasional tanpa "+", contoh 6281234567890.
# Kosongkan selama bot belum aktif; tombol WhatsApp di beranda disembunyikan.
SAYNO_WA_NUMBER=6285111412715
SAYNO_WEB_RATE_LIMIT=10
SAYNO_CONTACT_EMAIL=halo@lokashaka.id

# Token akses dashboard merek contoh (dipakai seeder). Kosong = dibuat acak dan dicetak saat seeding.
SAYNO_DEMO_BRAND_TOKEN=

# Hosting tanpa terminal (lihat DEPLOY.md). Isi teks acak minimal 32 karakter.
# SETUP membuka /_setup (migrate, seed, cache); kosongkan lagi setelah deploy selesai.
# CRON hanya perlu jika menu Cron Jobs cPanel tidak tersedia.
SAYNO_SETUP_TOKEN=
SAYNO_CRON_TOKEN=

SAFE_BROWSING_KEY=
GEMINI_API_KEY=

# WhatsApp Cloud API (Meta), diisi saat bot disambungkan.
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v25.0
BOT_FALLBACK_TOKEN=
